{
 "format": 1,
 "chain_default": ["dyn", "od", "dist", "cab", "eq", "mod", "trem", "echo", "reverb"],
 "effects": [
  {"id": "dyn", "name": "Dynamics", "short": "DYN", "icon": "compressor", "kind": "tone", "enable": "dyn_on", "bit": 7, "min_version": 519},
  {"id": "od", "name": "Overdrive", "short": "OD", "icon": "overdrive", "kind": "drive", "enable": "od_on", "bit": 0, "min_version": 513},
  {"id": "dist", "name": "Distortion", "short": "DIST", "icon": "distortion", "kind": "drive", "enable": "dist_on", "bit": 3, "min_version": 513},
  {"id": "cab", "name": "Cabinet", "short": "CAB", "icon": "cabinet", "kind": "tone", "enable": "cab_on", "bit": 6, "min_version": 517},
  {"id": "eq", "name": "EQ", "short": "EQ", "icon": "eq", "kind": "tone", "enable": "eq_on", "bit": 8, "min_version": 519},
  {"id": "mod", "name": "Chorus / Flanger / Vibrato", "short": "MOD", "icon": "chorus", "kind": "mod", "enable": "mod_on", "bit": 4, "min_version": 513},
  {"id": "trem", "name": "Tremolo", "short": "TREM", "icon": "tremolo", "kind": "mod", "enable": "trem_on", "bit": 1, "min_version": 513},
  {"id": "echo", "name": "Echo", "short": "ECHO", "icon": "echo", "kind": "time", "enable": "echo_on", "bit": 2, "min_version": 513},
  {"id": "reverb", "name": "Reverb", "short": "VERB", "icon": "reverb", "kind": "time", "enable": "reverb_on", "bit": 5, "min_version": 513}
 ],
 "registers": [
  {"reg": 0, "name": "effects_enable", "rw": "W", "bits": "[8:0]", "min_version": 513, "desc": "one enable bit per effect"},
  {"reg": 1, "name": "od_drive", "rw": "W", "bits": "[15:0]", "min_version": 513, "desc": "Overdrive clipping threshold"},
  {"reg": 2, "name": "od_gain", "rw": "W", "bits": "[15:0]", "min_version": 513, "desc": "Overdrive post-clip gain"},
  {"reg": 3, "name": "trem_wave", "rw": "W", "bits": "[3:0]", "min_version": 513, "desc": "Tremolo waveform / fixed rate (free mode from 0x0203)"},
  {"reg": 4, "name": "trem_depth", "rw": "W", "bits": "[7:0]", "min_version": 513, "desc": "Tremolo depth"},
  {"reg": 5, "name": "echo_time", "rw": "W", "bits": "[14:0]", "min_version": 513, "desc": "Echo delay in samples"},
  {"reg": 6, "name": "echo_repeat", "rw": "W", "bits": "[7:0]", "min_version": 513, "desc": "Echo feedback"},
  {"reg": 7, "name": "echo_level", "rw": "W", "bits": "[15:0]", "min_version": 513, "desc": "Echo wet level"},
  {"reg": 8, "name": "dist_mix", "rw": "W", "bits": "[7:0]", "min_version": 513, "desc": "Distortion dry/wet"},
  {"reg": 9, "name": "dist_type", "rw": "W", "bits": "[1:0]", "min_version": 513, "desc": "Distortion curve"},
  {"reg": 10, "name": "mod_mix", "rw": "W", "bits": "[7:0]", "min_version": 513, "desc": "Mod dry/wet (chorus level in v1)"},
  {"reg": 11, "name": "mod_depth", "rw": "W", "bits": "[10:0]", "min_version": 513, "desc": "Mod depth in samples"},
  {"reg": 12, "name": "mod_rate", "rw": "W", "bits": "[15:0]", "min_version": 513, "desc": "Mod LFO rate 0.01 Hz"},
  {"reg": 13, "name": "reverb_mix", "rw": "W", "bits": "[7:0]", "min_version": 513, "desc": "Reverb dry/wet"},
  {"reg": 14, "name": "reverb_type", "rw": "W", "bits": "[3:0]", "min_version": 513, "desc": "Reverb room"},
  {"reg": 16, "name": "version", "rw": "R", "bits": "[15:0]", "min_version": 513, "desc": "FPGA image version"},
  {"reg": 17, "name": "status", "rw": "R", "bits": "[2:0]", "min_version": 513, "desc": "codec init done, codec NAK, PLL locked"},
  {"reg": 18, "name": "level_in", "rw": "R", "bits": "[15:0]", "min_version": 513, "desc": "input peak level"},
  {"reg": 19, "name": "level_out", "rw": "R", "bits": "[15:0]", "min_version": 513, "desc": "output peak level"},
  {"reg": 20, "name": "control", "rw": "R/W", "bits": "[1:0]", "min_version": 513, "desc": "bit0 re-run codec init, bit1 mute"},
  {"reg": 21, "name": "codec", "rw": "R/W", "bits": "[15:0]", "min_version": 513, "desc": "WM8731 register write over I2C", "action": "codec"},
  {"reg": 22, "name": "trem_rate", "rw": "R/W", "bits": "[15:0]", "min_version": 515, "desc": "Tremolo free-mode rate 0.01 Hz"},
  {"reg": 24, "name": "mod_base", "rw": "R/W", "bits": "[10:0]", "min_version": 516, "desc": "Mod centre delay in samples"},
  {"reg": 25, "name": "mod_fb", "rw": "R/W", "bits": "[15:0]", "min_version": 516, "desc": "Mod feedback, signed Q15"},
  {"reg": 26, "name": "mod_shape", "rw": "R/W", "bits": "[0]", "min_version": 516, "desc": "Mod LFO shape"},
  {"reg": 27, "name": "cab_ctrl", "rw": "R/W", "bits": "[6:0]", "min_version": 517, "desc": "cabinet: active bank, shift bank0, shift bank1"},
  {"reg": 28, "name": "cab_addr", "rw": "R/W", "bits": "[11:0]", "min_version": 517, "desc": "cabinet coefficient pointer (bank, tap)", "action": "cab"},
  {"reg": 29, "name": "cab_data_lo", "rw": "R/W", "bits": "[15:0]", "min_version": 517, "desc": "cabinet coefficient low 16 bits", "action": "cab"},
  {"reg": 30, "name": "cab_data_hi", "rw": "R/W", "bits": "[1:0]", "min_version": 517, "desc": "cabinet coefficient bits 17:16, write stores and increments", "action": "cab"},
  {"reg": 31, "name": "reverb_size", "rw": "R/W", "bits": "[15:0]", "min_version": 518, "desc": "reverb size = comb feedback Q0.16 (type Custom), limited to 0.98 inside"},
  {"reg": 32, "name": "reverb_damp", "rw": "R/W", "bits": "[7:0]", "min_version": 518, "desc": "reverb damping 0..255 (type Custom)"},
  {"reg": 33, "name": "dyn_ctrl", "rw": "R/W", "bits": "[1:0]", "min_version": 519, "desc": "dynamics: bit0 noise gate on, bit1 compressor on"},
  {"reg": 34, "name": "gate_thresh", "rw": "R/W", "bits": "[15:0]", "min_version": 519, "desc": "gate threshold, signed Q8 log2 units re full scale"},
  {"reg": 35, "name": "comp_thresh", "rw": "R/W", "bits": "[15:0]", "min_version": 519, "desc": "compressor threshold, signed Q8 log2 units"},
  {"reg": 36, "name": "comp_ratio", "rw": "R/W", "bits": "[2:0]", "min_version": 519, "desc": "compressor ratio 1:1, 2:1, 4:1, 8:1, inf (4..7)"},
  {"reg": 37, "name": "comp_attack", "rw": "R/W", "bits": "[3:0]", "min_version": 519, "desc": "compressor attack, time constant 2^k samples"},
  {"reg": 38, "name": "comp_release", "rw": "R/W", "bits": "[3:0]", "min_version": 519, "desc": "compressor release, time constant 2^k samples"},
  {"reg": 39, "name": "comp_makeup", "rw": "R/W", "bits": "[15:0]", "min_version": 519, "desc": "compressor make-up gain, signed Q8 log2 units"},
  {"reg": 40, "name": "eq_addr", "rw": "R/W", "bits": "[3:0]", "min_version": 519, "desc": "EQ coefficient write pointer 0..15", "action": "eq"},
  {"reg": 41, "name": "eq_data_lo", "rw": "R/W", "bits": "[15:0]", "min_version": 519, "desc": "EQ coefficient bits 15..0", "action": "eq"},
  {"reg": 42, "name": "eq_data_hi", "rw": "R/W", "bits": "[1:0]", "min_version": 519, "desc": "EQ coefficient bits 17..16, write stores and increments", "action": "eq"},
  {"reg": 43, "name": "eq_apply", "rw": "W", "bits": "-", "min_version": 519, "desc": "any write applies the loaded EQ coefficient set", "action": "eq"},
  {"reg": 44, "name": "dyn_gr", "rw": "R", "bits": "[15:0]", "min_version": 519, "desc": "dynamics gain reduction, unsigned Q8 log2 units (read-only meter)", "action": "meter"},
  {"reg": 45, "name": "od_level", "rw": "R/W", "bits": "[15:0]", "min_version": 520, "desc": "overdrive output level, signed Q8 log2 units (0 = unity)"},
  {"reg": 46, "name": "dist_level", "rw": "R/W", "bits": "[15:0]", "min_version": 520, "desc": "distortion output level, signed Q8 log2 units (0 = unity)"}
 ],
 "params": [
  {"id": "dyn_on", "name": "Dynamics on", "group": "dyn", "reg": 0, "lsb": 7, "width": 1, "type": "bool", "min": 0, "max": 1, "default": 0, "unit": "", "mul": 1, "div": 1, "decimals": 0, "help": "Enable Dynamics (bypassed when off)", "min_version": 519, "in_preset": false},
  {"id": "gate_on", "section": "Noise gate", "section_switch": true, "name": "Noise gate on", "group": "dyn", "reg": 33, "lsb": 0, "width": 1, "type": "bool", "min": 0, "max": 1, "default": 0, "unit": "", "mul": 1, "div": 1, "decimals": 0, "help": "Noise gate: closes below the threshold (needs Dynamics on)", "min_version": 519, "in_preset": "user"},
  {"id": "gate_thresh", "section": "Noise gate", "gui_label": "Threshold", "name": "Gate threshold", "group": "dyn", "reg": 34, "lsb": 0, "width": 16, "type": "signed", "min": -6144, "max": 512, "default": -1913, "unit": "dB", "mul": 6.0206, "div": 256, "decimals": 1, "gui_min": -3840, "gui_max": 0, "help": "Level below which the gate closes (it opens at the threshold and closes 3 dB below it)", "min_version": 519, "in_preset": "user"},
  {"id": "comp_on", "section": "Compressor", "section_switch": true, "name": "Compressor on", "group": "dyn", "reg": 33, "lsb": 1, "width": 1, "type": "bool", "min": 0, "max": 1, "default": 0, "unit": "", "mul": 1, "div": 1, "decimals": 0, "help": "Compressor (needs Dynamics on)", "min_version": 519, "in_preset": "user"},
  {"id": "comp_thresh", "section": "Compressor", "gui_label": "Threshold", "name": "Comp threshold", "group": "dyn", "reg": 35, "lsb": 0, "width": 16, "type": "signed", "min": -6144, "max": 512, "default": -850, "unit": "dB", "mul": 6.0206, "div": 256, "decimals": 1, "gui_min": -3840, "gui_max": 0, "help": "Level above which the compressor reduces the gain", "min_version": 519, "in_preset": "user"},
  {"id": "comp_ratio", "section": "Compressor", "gui_label": "Ratio", "name": "Comp ratio", "group": "dyn", "reg": 36, "lsb": 0, "width": 3, "type": "enum", "min": 0, "max": 7, "default": 2, "unit": "", "mul": 1, "div": 1, "decimals": 0, "enum": [{"value": 0, "label": "1:1"}, {"value": 1, "label": "2:1"}, {"value": 2, "label": "4:1"}, {"value": 3, "label": "8:1"}, {"value": 4, "label": "Infinite"}, {"value": 5, "label": "Infinite (alias of 4 a)", "alias": true}, {"value": 6, "label": "Infinite (alias of 4 b)", "alias": true}, {"value": 7, "label": "Infinite (alias of 4 c)", "alias": true}], "help": "Compression ratio above the threshold", "min_version": 519, "in_preset": "user"},
  {"id": "comp_attack", "section": "Compressor", "gui_label": "Attack", "name": "Comp attack", "group": "dyn", "reg": 37, "lsb": 0, "width": 4, "type": "int", "min": 0, "max": 15, "default": 6, "unit": "ms", "mul": 1, "div": 48, "decimals": 2, "scale": "pow2", "help": "Gain attack time constant (hardware: 2^k samples, shown as the effective time)", "min_version": 519, "in_preset": "user"},
  {"id": "comp_release", "section": "Compressor", "gui_label": "Release", "name": "Comp release", "group": "dyn", "reg": 38, "lsb": 0, "width": 4, "type": "int", "min": 0, "max": 15, "default": 12, "unit": "ms", "mul": 1, "div": 48, "decimals": 2, "scale": "pow2", "help": "Gain release time constant (hardware: 2^k samples, shown as the effective time)", "min_version": 519, "in_preset": "user"},
  {"id": "comp_makeup", "section": "Compressor", "gui_label": "Make-up", "name": "Comp make-up", "group": "dyn", "reg": 39, "lsb": 0, "width": 16, "type": "signed", "min": -2048, "max": 2048, "default": 0, "unit": "dB", "mul": 6.0206, "div": 256, "decimals": 1, "gui_min": -1024, "gui_max": 1024, "help": "Make-up gain after the compressor", "min_version": 519, "in_preset": "user"},
  {"id": "od_on", "name": "Overdrive on", "group": "od", "reg": 0, "lsb": 0, "width": 1, "type": "bool", "min": 0, "max": 1, "default": 0, "unit": "", "mul": 1, "div": 1, "decimals": 0, "help": "Enable Overdrive (bypassed when off)", "min_version": 513, "in_preset": false},
  {"id": "dist_on", "name": "Distortion on", "group": "dist", "reg": 0, "lsb": 3, "width": 1, "type": "bool", "min": 0, "max": 1, "default": 0, "unit": "", "mul": 1, "div": 1, "decimals": 0, "help": "Enable Distortion (bypassed when off)", "min_version": 513, "in_preset": false},
  {"id": "cab_on", "name": "Cabinet on", "group": "cab", "reg": 0, "lsb": 6, "width": 1, "type": "bool", "min": 0, "max": 1, "default": 0, "unit": "", "mul": 1, "div": 1, "decimals": 0, "help": "Enable Cabinet (bypassed when off)", "min_version": 517, "in_preset": false},
  {"id": "eq_on", "name": "EQ on", "group": "eq", "reg": 0, "lsb": 8, "width": 1, "type": "bool", "min": 0, "max": 1, "default": 0, "unit": "", "mul": 1, "div": 1, "decimals": 0, "help": "Enable EQ (bypassed when off)", "min_version": 519, "in_preset": false},
  {"id": "mod_on", "name": "Chorus / Flanger / Vibrato on", "group": "mod", "reg": 0, "lsb": 4, "width": 1, "type": "bool", "min": 0, "max": 1, "default": 0, "unit": "", "mul": 1, "div": 1, "decimals": 0, "help": "Enable Chorus / Flanger / Vibrato (bypassed when off)", "min_version": 513, "in_preset": false},
  {"id": "trem_on", "name": "Tremolo on", "group": "trem", "reg": 0, "lsb": 1, "width": 1, "type": "bool", "min": 0, "max": 1, "default": 0, "unit": "", "mul": 1, "div": 1, "decimals": 0, "help": "Enable Tremolo (bypassed when off)", "min_version": 513, "in_preset": false},
  {"id": "echo_on", "name": "Echo on", "group": "echo", "reg": 0, "lsb": 2, "width": 1, "type": "bool", "min": 0, "max": 1, "default": 0, "unit": "", "mul": 1, "div": 1, "decimals": 0, "help": "Enable Echo (bypassed when off)", "min_version": 513, "in_preset": false},
  {"id": "reverb_on", "name": "Reverb on", "group": "reverb", "reg": 0, "lsb": 5, "width": 1, "type": "bool", "min": 0, "max": 1, "default": 0, "unit": "", "mul": 1, "div": 1, "decimals": 0, "help": "Enable Reverb (bypassed when off)", "min_version": 513, "in_preset": false},
  {"id": "od_drive", "name": "Drive", "group": "od", "reg": 1, "lsb": 0, "width": 16, "type": "int", "min": 0, "max": 65535, "default": 2000, "unit": "", "mul": 1, "div": 1, "decimals": 0, "gui_min": 0, "gui_max": 3500, "help": "Clipping threshold (sample amplitude); lower = more distortion", "min_version": 513, "in_preset": true},
  {"id": "od_gain", "name": "Gain", "group": "od", "reg": 2, "lsb": 0, "width": 16, "type": "int", "min": 0, "max": 65535, "default": 2, "unit": "", "mul": 1, "div": 1, "decimals": 0, "gui_min": 1, "gui_max": 5, "help": "Integer post-clip gain multiplier", "min_version": 513, "in_preset": true},
  {"id": "od_level", "name": "Output level", "group": "od", "reg": 45, "lsb": 0, "width": 16, "type": "signed", "min": -1024, "max": 512, "default": 0, "unit": "dB", "mul": 6.0206, "div": 256, "decimals": 1, "gui_min": -1024, "gui_max": 512, "help": "Loudness of the overdrive (0 dB = unity, smoothed in the FPGA)", "min_version": 520, "in_preset": true},
  {"id": "dist_mix", "name": "Mix", "group": "dist", "reg": 8, "lsb": 0, "width": 8, "type": "int", "min": 0, "max": 255, "default": 160, "unit": "%", "mul": 100, "div": 255, "decimals": 1, "help": "Dry/wet mix", "min_version": 513, "in_preset": true},
  {"id": "dist_type", "name": "Type", "group": "dist", "reg": 9, "lsb": 0, "width": 2, "type": "enum", "min": 0, "max": 3, "default": 1, "unit": "", "mul": 1, "div": 1, "decimals": 0, "help": "Clipping curve", "min_version": 513, "enum": [{"value": 0, "label": "Soft"}, {"value": 1, "label": "Medium"}, {"value": 2, "label": "Heavy"}, {"value": 3, "label": "Soft (alias of 0)", "alias": true}], "in_preset": true},
  {"id": "dist_level", "name": "Output level", "group": "dist", "reg": 46, "lsb": 0, "width": 16, "type": "signed", "min": -1024, "max": 512, "default": 0, "unit": "dB", "mul": 6.0206, "div": 256, "decimals": 1, "gui_min": -1024, "gui_max": 512, "help": "Loudness of the distorted signal before the dry/wet mix (0 dB = unity)", "min_version": 520, "in_preset": true},
  {"id": "mod_mix", "name": "Mix", "group": "mod", "reg": 10, "lsb": 0, "width": 8, "type": "int", "min": 0, "max": 255, "default": 128, "unit": "%", "mul": 100, "div": 255, "decimals": 1, "help": "Dry/wet mix", "min_version": 513, "aliases": ["chorus_level"], "in_preset": true},
  {"id": "mod_depth", "section": "LFO", "name": "Depth", "group": "mod", "reg": 11, "lsb": 0, "width": 11, "type": "int", "min": 0, "max": 2047, "default": 144, "unit": "ms", "mul": 1, "div": 48, "decimals": 2, "gui_min": 0, "gui_max": 1000, "help": "Delay swing around the base delay", "min_version": 513, "aliases": ["chorus_depth"], "in_preset": true},
  {"id": "mod_rate", "section": "LFO", "gui_taper": "log", "name": "Rate", "group": "mod", "reg": 12, "lsb": 0, "width": 16, "type": "int", "min": 0, "max": 65535, "default": 80, "unit": "Hz", "mul": 1, "div": 100, "decimals": 2, "gui_min": 1, "gui_max": 2000, "help": "LFO rate", "min_version": 513, "aliases": ["chorus_rate"], "in_preset": true},
  {"id": "mod_base", "section": "Delay line", "name": "Base delay", "group": "mod", "reg": 24, "lsb": 0, "width": 11, "type": "int", "min": 0, "max": 2047, "default": 720, "unit": "ms", "mul": 1, "div": 48, "decimals": 2, "gui_min": 1, "gui_max": 2046, "help": "Centre delay (chorus 15 ms, flanger 2 ms, vibrato 5 ms)", "min_version": 516, "in_preset": true},
  {"id": "mod_fb", "section": "Delay line", "name": "Feedback", "group": "mod", "reg": 25, "lsb": 0, "width": 16, "type": "signed", "min": -32767, "max": 32767, "default": 0, "unit": "%", "mul": 100, "div": 32767, "decimals": 1, "help": "Feedback, negative inverts (flanger)", "min_version": 516, "in_preset": true},
  {"id": "mod_shape", "section": "LFO", "gui_label": "Shape", "name": "LFO shape", "group": "mod", "reg": 26, "lsb": 0, "width": 1, "type": "enum", "min": 0, "max": 1, "default": 0, "unit": "", "mul": 1, "div": 1, "decimals": 0, "help": "LFO waveform", "min_version": 516, "enum": [{"value": 0, "label": "Sine"}, {"value": 1, "label": "Triangle"}], "in_preset": true},
  {"id": "trem_wave", "name": "Waveform", "group": "trem", "reg": 3, "lsb": 0, "width": 4, "type": "enum", "min": 0, "max": 11, "default": 0, "unit": "", "mul": 1, "div": 1, "decimals": 0, "help": "Fixed waveform/rate (0-7) or free mode shape (8-11, rate from trem_rate)", "min_version": 513, "enum": [{"value": 0, "label": "Sine 5 Hz"}, {"value": 1, "label": "Sine 7 Hz"}, {"value": 2, "label": "Sine 10 Hz"}, {"value": 3, "label": "Sine 12 Hz"}, {"value": 4, "label": "Sine 15 Hz"}, {"value": 5, "label": "Triangle 5 Hz"}, {"value": 6, "label": "Triangle 10 Hz"}, {"value": 7, "label": "Sawtooth 10 Hz"}, {"value": 8, "label": "Free sine"}, {"value": 9, "label": "Free triangle"}, {"value": 10, "label": "Free sawtooth"}, {"value": 11, "label": "Free square"}], "in_preset": true},
  {"id": "trem_depth", "name": "Depth", "group": "trem", "reg": 4, "lsb": 0, "width": 8, "type": "int", "min": 0, "max": 255, "default": 200, "unit": "%", "mul": 100, "div": 255, "decimals": 1, "help": "0 = dry, 100% = full modulation", "min_version": 513, "in_preset": true},
  {"id": "trem_rate", "gui_taper": "log", "gui_when": {"param": "trem_wave", "in": ["Free sine", "Free triangle", "Free sawtooth", "Free square"]}, "name": "Rate", "group": "trem", "reg": 22, "lsb": 0, "width": 16, "type": "int", "min": 0, "max": 65535, "default": 650, "unit": "Hz", "mul": 1, "div": 100, "decimals": 2, "gui_min": 1, "gui_max": 2000, "help": "LFO rate in free mode (waveform 8-11)", "min_version": 515, "in_preset": true},
  {"id": "echo_time", "name": "Time", "group": "echo", "reg": 5, "lsb": 0, "width": 15, "type": "int", "min": 0, "max": 32767, "default": 14400, "unit": "ms", "mul": 1, "div": 48, "decimals": 1, "help": "Delay time (changing it glides like a tape echo)", "min_version": 513, "in_preset": true},
  {"id": "echo_repeat", "name": "Repeat", "group": "echo", "reg": 6, "lsb": 0, "width": 8, "type": "int", "min": 0, "max": 255, "default": 90, "unit": "%", "mul": 100, "div": 256, "decimals": 1, "help": "Feedback amount", "min_version": 513, "in_preset": true},
  {"id": "echo_level", "name": "Level", "group": "echo", "reg": 7, "lsb": 0, "width": 16, "type": "int", "min": 0, "max": 65535, "default": 20000, "unit": "%", "mul": 100, "div": 65535, "decimals": 1, "gui_min": 0, "gui_max": 32000, "help": "Wet level", "min_version": 513, "in_preset": true},
