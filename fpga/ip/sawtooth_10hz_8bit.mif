-- Sawtooth LFO for the tremolo, 10 Hz @ 48 kHz (4800 samples), 8-bit unsigned.
-- Rises 0..254 over 4560 samples, then ramps back to 0 over 240 samples (5 ms)
-- instead of resetting instantly (an instant reset causes an audible click).
WIDTH=8;
DEPTH=4800;

ADDRESS_RADIX=UNS;
DATA_RADIX=DEC;

