# -----------------------------------------------------------------------------
# Guitar multi-effect v2 - Quartus Prime Lite 18.1 project settings
# Target board : Terasic DE1-SoC (Cyclone V SE 5CSEMA5F31C6)
# No Platform Designer / Nios II: top_v2 = PLL + gme_core (see docs/v2_stepB_design.md)
# -----------------------------------------------------------------------------
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY top_v2
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 18.1.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "11:08:34  JULY 01, 2021"
set_global_assignment -name LAST_QUARTUS_VERSION "18.1.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top

# ---- Constraints
set_global_assignment -name SDC_FILE top_v2.sdc

# ---- RTL
set_global_assignment -name VERILOG_FILE rtl/pll_sys.v
set_global_assignment -name QIP_FILE hps_sys/synthesis/hps_sys.qip
set_global_assignment -name VHDL_FILE rtl/fx_pkg.vhd
set_global_assignment -name VHDL_FILE rtl/fx_dpram.vhd
set_global_assignment -name VHDL_FILE rtl/fx_xfade.vhd
set_global_assignment -name VHDL_FILE rtl/param_smooth.vhd
set_global_assignment -name VHDL_FILE rtl/lfo_sine_pkg.vhd
set_global_assignment -name VHDL_FILE rtl/nco_lfo.vhd
set_global_assignment -name VHDL_FILE rtl/overdrive.vhd
set_global_assignment -name VHDL_FILE rtl/distortion.vhd
set_global_assignment -name VHDL_FILE rtl/mod_delay.vhd
set_global_assignment -name VHDL_FILE rtl/tremolo_v2.vhd
set_global_assignment -name VHDL_FILE rtl/echo.vhd
set_global_assignment -name VHDL_FILE rtl/fv_comb.vhd
set_global_assignment -name VHDL_FILE rtl/fv_allpass.vhd
set_global_assignment -name VHDL_FILE rtl/reverb_fv.vhd
set_global_assignment -name VHDL_FILE rtl/cab_coef_ram.vhd
set_global_assignment -name VHDL_FILE rtl/cab_fir.vhd
set_global_assignment -name VHDL_FILE rtl/cab_stage.vhd
set_global_assignment -name VHDL_FILE rtl/FX_chain.vhd
set_global_assignment -name VHDL_FILE rtl/i2s_core.vhd
set_global_assignment -name VHDL_FILE rtl/reg_file.vhd
set_global_assignment -name VHDL_FILE rtl/ctrl_avmm.vhd
set_global_assignment -name VHDL_FILE rtl/i2c_master.vhd
set_global_assignment -name VHDL_FILE rtl/codec_ctrl.vhd
set_global_assignment -name VHDL_FILE rtl/gme_core.vhd
set_global_assignment -name VHDL_FILE rtl/top_v2.vhd

# ---- Intel megafunction wrappers (RAM / ROM) and .mif tables
set_global_assignment -name QIP_FILE ip/dist_ROM_soft.qip
set_global_assignment -name QIP_FILE ip/dist_ROM_medium.qip
set_global_assignment -name QIP_FILE ip/dist_ROM_hard.qip
set_global_assignment -name MIF_FILE ip/distortion_hard.mif
set_global_assignment -name MIF_FILE ip/distortion_medium.mif
set_global_assignment -name MIF_FILE ip/distortion_soft.mif
set_global_assignment -name MIF_FILE ip/cab_default.mif

# ---- Pin assignments (DE1-SoC)
set_location_assignment PIN_AF14 -to CLOCK_50
set_location_assignment PIN_AA14 -to KEY0
set_location_assignment PIN_G7 -to AUD_XCK
set_location_assignment PIN_H7 -to AUD_BCLK
set_location_assignment PIN_K8 -to AUD_ADCLRCK
set_location_assignment PIN_H8 -to AUD_DACLRCK
set_location_assignment PIN_K7 -to AUD_ADCDAT
set_location_assignment PIN_J7 -to AUD_DACDAT
set_location_assignment PIN_J12 -to FPGA_I2C_SCLK
set_location_assignment PIN_K12 -to FPGA_I2C_SDAT
set_location_assignment PIN_V16 -to LEDR[0]
set_location_assignment PIN_W16 -to LEDR[1]
set_location_assignment PIN_V17 -to LEDR[2]
set_location_assignment PIN_V18 -to LEDR[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLOCK_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KEY0
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to AUD_XCK
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to AUD_BCLK
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to AUD_ADCLRCK
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to AUD_DACLRCK
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to AUD_ADCDAT
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to AUD_DACDAT
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to FPGA_I2C_SCLK
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to FPGA_I2C_SDAT
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDR[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDR[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDR[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDR[3]

# ---- HPS (DDR3 + HPS I/O): I/O standards and termination from Terasic GHRD ----
