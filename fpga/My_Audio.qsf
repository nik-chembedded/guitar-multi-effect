set_location_assignment PIN_AF15 -to sdram_addr[7]
set_location_assignment PIN_AG10 -to sdram_dq[5]
set_location_assignment PIN_AG11 -to sdram_cs_n
set_location_assignment PIN_AG12 -to sdram_addr[10]
