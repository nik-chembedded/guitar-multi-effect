# -----------------------------------------------------------------------------
# Guitar multi-effect - Quartus Prime 18.1 Lite project settings
# Target board : Terasic DE1-SoC (Cyclone V SE 5CSEMA5F31C6)
# -----------------------------------------------------------------------------
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY top_project
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 18.1.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "11:08:34  JULY 01, 2021"
set_global_assignment -name LAST_QUARTUS_VERSION "18.1.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top

# ---- Platform Designer system (generate with: qsys-generate my_audio.qsys --synthesis=VHDL)
set_global_assignment -name QIP_FILE my_audio/synthesis/my_audio.qip
set_global_assignment -name SDC_FILE My_Audio.sdc

# ---- RTL
set_global_assignment -name VHDL_FILE rtl/fx_pkg.vhd
set_global_assignment -name VHDL_FILE rtl/top_project.vhd
set_global_assignment -name VHDL_FILE rtl/audio_processor.vhd
set_global_assignment -name VHDL_FILE rtl/ADC_CONTROLLER.vhd
set_global_assignment -name VHDL_FILE rtl/DAC_CONTROLLER.vhd
set_global_assignment -name VHDL_FILE rtl/FX_chain.vhd
set_global_assignment -name VHDL_FILE rtl/overdrive.vhd
set_global_assignment -name VHDL_FILE rtl/distortion.vhd
set_global_assignment -name VHDL_FILE rtl/chorus.vhd
set_global_assignment -name VHDL_FILE rtl/tremolo_v2.vhd
set_global_assignment -name VHDL_FILE rtl/echo.vhd
set_global_assignment -name VHDL_FILE rtl/reverbe.vhd
set_global_assignment -name VHDL_FILE rtl/comb_filter.vhd
set_global_assignment -name VHDL_FILE rtl/allpass_filter.vhd

# ---- Intel megafunction wrappers (FIFO / RAM / ROM) and their .mif tables
set_global_assignment -name QIP_FILE ip/my_fifo.qip
set_global_assignment -name QIP_FILE ip/echo_ram.qip
set_global_assignment -name QIP_FILE ip/chorus_RAM.qip
set_global_assignment -name QIP_FILE ip/fcomb_RAM2.qip
set_global_assignment -name QIP_FILE ip/fcomb_RAM4.qip
set_global_assignment -name QIP_FILE ip/dist_ROM_soft.qip
set_global_assignment -name QIP_FILE ip/dist_ROM_medium.qip
set_global_assignment -name QIP_FILE ip/dist_ROM_hard.qip
set_global_assignment -name QIP_FILE ip/sine_5hz.qip
set_global_assignment -name QIP_FILE ip/sine_7hz.qip
set_global_assignment -name QIP_FILE ip/my_sin_10hz.qip
set_global_assignment -name QIP_FILE ip/sine_12hz.qip
set_global_assignment -name QIP_FILE ip/sine_15hz.qip
set_global_assignment -name QIP_FILE ip/triangle_5hz.qip
set_global_assignment -name QIP_FILE ip/triangle_10hz.qip
set_global_assignment -name VHDL_FILE ip/saw_10hz.vhd
set_global_assignment -name MIF_FILE ip/distortion_hard.mif
set_global_assignment -name MIF_FILE ip/distortion_medium.mif
set_global_assignment -name MIF_FILE ip/distortion_soft.mif
set_global_assignment -name MIF_FILE ip/my_sin.mif
set_global_assignment -name MIF_FILE ip/sawtooth_10hz_8bit.mif
set_global_assignment -name MIF_FILE ip/sine_12hz_8bit.mif
set_global_assignment -name MIF_FILE ip/sine_15hz_8bit.mif
set_global_assignment -name MIF_FILE ip/sine_5hz_8bit.mif
set_global_assignment -name MIF_FILE ip/sine_7hz_8bit.mif
set_global_assignment -name MIF_FILE ip/triangle_10hz_8bit.mif
set_global_assignment -name MIF_FILE ip/triangle_5hz_8bit.mif

# ---- Pin assignments (DE1-SoC)
set_location_assignment PIN_AA13 -to sdram_we_n
set_location_assignment PIN_AB12 -to reset_n
set_location_assignment PIN_AB13 -to sdram_dqm[0]
set_location_assignment PIN_AB15 -to sdram_addr[4]
set_location_assignment PIN_AC12 -to LR_RESET
set_location_assignment PIN_AC14 -to sdram_addr[5]
